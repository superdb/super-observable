diff -ruN a/sio/anyio/arrow.go b/sio/anyio/arrow.go
--- a/sio/anyio/arrow.go	1969-12-31 19:00:00
+++ b/sio/anyio/arrow.go	2026-11-20 05:07:25
@@ -0,0 +1,43 @@
+//go:build !noarrow
+
+package anyio
+
+import (
+	"context"
+	"io"
+
+	"github.com/superdb/super"
+	"github.com/superdb/super/sio/arrowio"
+	"github.com/superdb/super/sio/parquetio"
+	"github.com/superdb/super/vector/vio"
+)
+
+func newArrowReader(sctx *super.Context, r io.Reader) (vio.Puller, error) {
+	ar, err := arrowio.NewReader(sctx, r)
+	if err != nil {
+		return nil, err
+	}
+	return newVioPuller(sctx, ar), nil
+}
+
+func probeArrow(r io.Reader) error {
+	ar, err := arrowio.NewReader(super.NewContext(), r)
+	if err != nil {
+		return err
+	}
+	defer ar.Close()
+	_, err = ar.Read()
+	return err
+}
+
+func newParquetReader(ctx context.Context, sctx *super.Context, r io.Reader, p vio.Pushdown, n int) (vio.Puller, error) {
+	return parquetio.NewReader(ctx, sctx, r, p, n)
+}
+
+func newArrowWriter(sctx *super.Context, w io.WriteCloser) (vio.PushCloser, error) {
+	return newDefuser(sctx, arrowio.NewWriter(w)), nil
+}
+
+func newParquetWriter(sctx *super.Context, w io.WriteCloser) (vio.PushCloser, error) {
+	return newDefuser(sctx, parquetio.NewWriter(w)), nil
+}
